# ============================================================
# Production environment for /opt/worknai/.env on the VPS
# (or paste the whole file into the PROD_ENV_FILE GitHub secret)
# Shared by the backend and web containers.
# ============================================================

# --- Auth (MUST be identical for backend + web; generate: openssl rand -hex 48)
JWT_SECRET=change_me

# --- Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for the one-off scripts in services/backend/src/scripts
DATABASE_URL=
SUPABASE_DB_PASSWORD=

# --- Domains (host-based routing in apps/web/proxy.ts)
MAIN_HOST=worknai.media
ADMIN_HOST=admin.worknai.media
CORS_ORIGINS=https://worknai.media,https://admin.worknai.media

# --- Instagram / Meta publishing (optional: can also be set in Admin > Integrations)
META_APP_ID=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_NAME=

# --- AI
OPENAI_API_KEY=

# --- Localhost port the Docker stack listens on (host nginx proxies to it)
WORKNAI_HTTP_PORT=8390

# --- Managed by deploy/scripts/deploy.sh (do not edit)
# IMAGE_TAG=
# WEB_IMAGE=
# BACKEND_IMAGE=
